# Copy to .env and adjust. Every variable is optional; the defaults below match
# the built-in defaults, so the server runs with no .env at all.

# TCP listen address (host:port). Empty host binds all interfaces.
TYPEMORE_ADDR=:8080

# Log level: debug | info | warn | error
TYPEMORE_LOG_LEVEL=info

# Log format: json | text
TYPEMORE_LOG_FORMAT=json

# Graceful shutdown budget for in-flight connections.
TYPEMORE_SHUTDOWN_TIMEOUT=10s

# Max time to read request headers.
TYPEMORE_READ_HEADER_TIMEOUT=5s

# WebSocket Origin allow-list (comma-separated, wildcards allowed e.g.
# https://*.typemore.gg). Empty = allow any origin (development only).
TYPEMORE_ALLOWED_ORIGINS=

# --- Database ---
# PostgreSQL DSN. For the docker-compose stack the app overrides this to reach
# the `postgres` service; this default is for running the server on the host.
TYPEMORE_DATABASE_URL=postgres://typemore:typemore@localhost:5432/typemore?sslmode=disable
TYPEMORE_DB_MAX_CONNS=10

# --- Sessions & CSRF ---
# SPA origin: allowed CORS origin, required Origin for mutating requests, and
# base URL for email links.
TYPEMORE_FRONTEND_ORIGIN=http://localhost:5173

# Admin bootstrap (docs/MODERATION.md): comma-separated emails whose VERIFIED
# accounts are promoted to the admin role at startup. Promotion only — removing
# an email demotes nobody. Empty (the default) disables the /api/v1/admin
# subtree entirely: no admins, no admin surface.
TYPEMORE_ADMINS=
TYPEMORE_COOKIE_NAME=tm_session
TYPEMORE_COOKIE_DOMAIN=
# Set false for plain-HTTP local dev; true in production (HTTPS).
TYPEMORE_COOKIE_SECURE=true
TYPEMORE_SESSION_TTL=720h

# --- OAuth (leave blank to disable a provider) ---
# Create apps at https://github.com/settings/developers and
# https://console.cloud.google.com/apis/credentials; see README.
TYPEMORE_GITHUB_CLIENT_ID=
TYPEMORE_GITHUB_CLIENT_SECRET=
TYPEMORE_GOOGLE_CLIENT_ID=
TYPEMORE_GOOGLE_CLIENT_SECRET=
# Public base URL of THIS server; must match the redirect URIs registered with
# each provider (callback = <base>/api/v1/auth/oauth/<provider>/callback).
TYPEMORE_OAUTH_REDIRECT_BASE=http://localhost:8080

# --- Email / SMTP ---
# Empty host = no real send; the server logs the link instead. Dev uses Mailpit
# (compose service: host=mailpit port=1025).
TYPEMORE_SMTP_HOST=
TYPEMORE_SMTP_PORT=1025
TYPEMORE_SMTP_USERNAME=
TYPEMORE_SMTP_PASSWORD=
TYPEMORE_SMTP_FROM=no-reply@typemore.local

# --- Abuse control ---
# Per-IP token bucket across auth endpoints: one token every AUTH_RATE_EVERY,
# bucket size AUTH_RATE_BURST.
TYPEMORE_AUTH_RATE_EVERY=1s
TYPEMORE_AUTH_RATE_BURST=10
# Per-user token bucket on POST /runs (a typing session is many runs): burst
# RUNS_RATE_BURST, one token refilled every RUNS_RATE_EVERY (≈120 runs/hour).
TYPEMORE_RUNS_RATE_EVERY=30s
TYPEMORE_RUNS_RATE_BURST=120
# Cloudflare Turnstile secret key. EMPTY = captcha DISABLED entirely: register,
# verify/resend and password-reset/request take no turnstileToken and inspect
# none. Empty is the dev default on purpose — a captcha is a third-party
# dependency, and neither `make run` nor the test suite should need a
# Cloudflare account or outbound network to create an account. Set it in
# staging/prod (pair it with VITE_TURNSTILE_SITE_KEY on the frontend). For
# local experiments use Cloudflare's published test keys, listed in
# docs/AUTH.md — e.g. 1x0000000000000000000000000000000AA always passes.
TYPEMORE_TURNSTILE_SECRET=

# --- Background cleanup ---
# How often the janitor deletes expired sessions and stale email tokens.
# Zero or negative disables it.
TYPEMORE_AUTH_CLEANUP_INTERVAL=1h

# --- Replay worker (docs/REPLAY.md) ---
# Recomputes every pending run through the vendored core bundle in goja and
# sets its authoritative status. Disable it to run an API-only replica.
TYPEMORE_REPLAY_ENABLED=true
# Wait after an EMPTY batch; a full batch is followed immediately, so a backlog
# drains at full speed.
TYPEMORE_REPLAY_POLL_INTERVAL=2s
# Runs claimed per transaction — also how long that transaction holds its row
# locks (FOR UPDATE SKIP LOCKED).
#
# 2, and deliberately NOT restored to 20 now that the core is fixed. The claim,
# every verdict and the commit share ONE transaction, so the locks are held for
# up to batchSize x REPLAY_TIMEOUT, inside the same transaction the leaderboard
# projection runs in. 20 was fine against a 5s timeout (100s); against the 45s
# below it would be 15 minutes. 2 x 45s = 90s is the old ceiling, restored.
TYPEMORE_REPLAY_BATCH_SIZE=2
# Worker goroutines; each owns a goja runtime and they share the queue.
#
# One goroutine does 5.8 realistic runs/s, which is 0.42x a plausible four-hour
# peak (docs/PERFORMANCE.md, zone 2). A maximum-size submission now parks a
# goroutine for ~7s rather than over a minute, so this is no longer a stop-gap
# — it is just cheap headroom, and three workers keep draining regardless.
TYPEMORE_REPLAY_CONCURRENCY=4
# Interrupt budget for one core call. A run that exceeds it is flagged
# replay_timeout rather than allowed to occupy a worker.
#
# 45s, down from the 300s stop-gap: the core's quadratic fold is fixed, so the
# run that cost 76.5s now costs 3.4s. Sized against the CURRENT ingestion caps
# (120 000 events / 6.5 MiB), which were raised so a full 10 000-word run is
# actually submittable:
#   german   10k words,  79 394 events — 7.18s worst sample, measured
#   code_css 10k words, 108 274 events — ~8.1s, the worst of the nine
#                                        published dictionaries
# 45s is 5.6x that worst case. 30s would have been 3.7x; it only cleared 5x
# under the old caps, where the worst legal run was 4.3s.
TYPEMORE_REPLAY_TIMEOUT=45s
# Ceiling on finishing an in-flight batch after the shutdown signal, so
# verdicts commit instead of rolling back. It is also the deadline on EVERY
# batch, so it has to cover the worst case the two knobs above can produce
# (2 x 45s of interpreter) plus the database work: a smaller value clamps the
# per-run budget below the timeout and rolls the batch back instead of
# committing it. Cost: a deploy may wait two minutes, down from ten.
TYPEMORE_REPLAY_SHUTDOWN_GRACE=120s

# --- Replay review policy (docs/REPLAY.md, "Review policy") ---
# Which plausibility flags are worth what, and how much weighted severity sends
# a run to a human. A single weak flag (one 14ms interval out of a hundred)
# never reaches review on its own; a bot-shaped combination always does.
#
# ALL THREE REQUIRE A BINARY BUILT WITH `-tags anticheat` (make build-anticheat).
# A plain build contains no policy to tune — not a disabled one, none: the
# weights and rule names are not compiled in, which is what stops `strings` from
# reading the answer key off the binary. Setting these on such a build logs a
# warning and changes nothing. See docs/SELF_HOST.md.
#
# Per-code weight overrides, "code=weight,code=weight". Unlisted codes keep
# their calibrated default; an unknown code is a STARTUP ERROR, not a warning.
TYPEMORE_REPLAY_FLAG_WEIGHTS=
# Suspicion (Σ weight × severity) at or above which a run is flagged for review.
# Empty/0 keeps the calibrated default of 1.0.
TYPEMORE_REPLAY_REVIEW_THRESHOLD=
# Duration floor for the sustained-superhuman combination rule, in seconds.
# Empty/0 keeps the calibrated default of 10.
TYPEMORE_REPLAY_SUSTAINED_BURST_SEC=

# When the canary-rendering client went live, RFC3339 (docs/REPLAY.md, "Canary
# epoch"). A run created at or after it is judged with the canary detectors
# armed; every earlier run is judged exactly as it always was.
#
# EMPTY ARMS NOTHING, and that is the correct value until the frontend that
# renders canaries is actually deployed. The schedule is derived from a run's
# seed, so it is computable for the whole archive — arming runs whose client
# never drew a canary would score coincidence as evidence, and `make revalidate`
# would do it to all of history at once. Set it by hand, once, AFTER the
# frontend deploy: e.g. 2026-08-01T12:00:00Z
TYPEMORE_REPLAY_CANARY_EPOCH=

# --- Leaderboards (docs/LEADERBOARDS.md) ---
# Require a verified email identity to hold a board slot. On by default: a slot
# is worth more than a throwaway account costs, and an address someone can
# actually receive mail at is the cheapest barrier that does not punish real
# players. Flipping this affects runs already judged only after
# `make rebuild-leaderboards`.
TYPEMORE_LEADERBOARD_REQUIRE_VERIFIED_EMAIL=true
# Per-IP token bucket on the PUBLIC GET /runs/{id}/replay endpoint. An event log
# is the heaviest payload the server serves and the route needs no session, so
# it is limited far more tightly than the authenticated surface.
TYPEMORE_LEADERBOARD_REPLAY_RATE_EVERY=2s
TYPEMORE_LEADERBOARD_REPLAY_RATE_BURST=30

# Per-IP token bucket on the PUBLIC GET /api/v1/users?q= player search
# (docs/PROFILE.md, "Search"). Sized for a search box that queries as the user
# types: a 300 ms debounce makes ~3 req/s while a name is being typed, so the
# burst absorbs typing a name out in full, and the refill sets the sustained
# rate at 2/s — below typing speed on purpose. It is the one profile route with
# a limit at all: the rest are bounded by one player's history, while this one
# reads an index over every account without needing a session.
TYPEMORE_PROFILE_SEARCH_RATE_EVERY=500ms
TYPEMORE_PROFILE_SEARCH_RATE_BURST=30

# Per-ACCOUNT token bucket on POST /api/v1/reports (docs/REPORTS.md). Keyed by
# account rather than by IP because the route needs a session anyway, and an
# account is what a report is attributed to. Filing is a deliberate, rare act.
# The harder cap is not here but in the domain: one reporter may hold only 20
# reports OPEN at once, which no refill rate can wash away.
TYPEMORE_REPORT_RATE_EVERY=1m
TYPEMORE_REPORT_RATE_BURST=5

# --- Lobby discovery (docs/PROTOCOL.md §5) ---
# Per-IP token bucket on the PUBLIC GET /api/v1/rooms room list. The lobby
# screen polls it every 4s (0.25 req/s) and this bucket refills at 0.5 tokens/s
# — twice the poll rate, so a correct client never sees the limit; the burst of
# 30 absorbs reload storms, several tabs, or a few players behind one NAT.
TYPEMORE_LOBBY_RATE_EVERY=2s
TYPEMORE_LOBBY_RATE_BURST=30

# --- Password hashing gate (docs/PERFORMANCE.md, zone 1) ---
# argon2id costs ~19 MiB and ~25 ms per hash BY DESIGN, and the server pays it
# before it knows anything about the caller — on every login, valid or not (the
# decoy verify that keeps the two timing-indistinguishable). Ungated, 200
# concurrent login attempts measured 1.4-2.5 GiB of heap from requests that need
# no account; the per-IP rate limiter cannot stop it, because a distributed
# caller never trips it and the memory is committed by the hash it already let
# through. The gate bounds concurrent hashes and sheds the rest with 503.
#
# Explicit slot count. Empty derives it from the budget below.
TYPEMORE_AUTH_HASH_CONCURRENCY=
# Peak memory hashing may hold, in bytes. Empty derives it from the detected
# process ceiling (GOMEMLIMIT -> cgroup -> MemAvailable), a quarter of it, or
# 512 MiB when nothing can be detected. Divided by 3x the per-hash cost, because
# the measured peak heap is 2.4-3.7x nominal at the default collector.
TYPEMORE_AUTH_HASH_MEMORY_BUDGET=
# How long a request queues for a slot before it is shed with 503.
TYPEMORE_AUTH_HASH_WAIT=500ms
